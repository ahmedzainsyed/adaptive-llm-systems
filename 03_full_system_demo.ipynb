"""
benchmark/evolution_loop.py

AgenticBenchmarkSystem — Main Orchestration Loop (Project 3).

This is the top-level system that coordinates all four agents
in a continuous task evolution loop.

One evolution cycle:
  1. TaskGeneratorAgent     generates N tasks (seed or failure-conditioned)
  2. Base LLM               generates responses to each task
  3. EvaluatorModel (P1)    scores responses → identifies failures
  4. FailureAnalyzerAgent   classifies and clusters failures
  5. DifficultyController   adjusts next-cycle difficulty
  6. TaskRefinerAgent       generates new adversarial tasks from clusters
  7. System logs metrics    → W&B for experiment tracking

Integration:
  - Detected failures are also routed to Project 2 RLHF training
  - Evaluator confidence signals the uncertainty of each scoring
  - All metrics logged to W&B for research reporting
"""

from __future__ import annotations

import json
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import List, Optional, Dict, Tuple
import numpy as np
import torch
import wandb
from loguru import logger

from benchmark.agents import (
    TaskGeneratorAgent,
    FailureAnalyzerAgent,
    DifficultyController,
    TaskRefinerAgent,
    GeneratedTask,
    TASK_CATEGORIES,
)


@dataclass
class Task:
    """Extended Task record including evaluation results."""
    generated: GeneratedTask
    response: str = ""
    evaluator_score: float = 0.0
    evaluator_confidence: float = 1.0
    failed: bool = False
    failure_type: str = ""
    cycle: int = 0


@dataclass
class CycleMetrics:
    """Metrics for one evolution cycle."""
    cycle: int
    n_tasks_generated: int
    n_failures: int
    failure_rate: float
    difficulty: float
    unique_failure_clusters: int
    n_adversarial_tasks: int
    mean_evaluator_confidence: float
    top_failure_types: List[str]


class AgenticBenchmarkSystem:
    """
    Full agentic benchmark generation and evolution system.

    Coordinates TaskGeneratorAgent, FailureAnalyzerAgent,
    DifficultyController, and TaskRefinerAgent in a continuous loop.

    Each cycle:
      - Generates tasks → evaluates them → analyzes failures
      - Conditions next cycle's tasks on observed failure modes
      - Adapts difficulty to maintain ~50% failure rate

    The task pool grows over time, building up a rich, diverse
    evaluation dataset that continuously exposes new model weaknesses.
    """

    def __init__(
        self,
        evaluator,                            # Project 1 EvaluatorModel
        base_llm=None,                        # Model under evaluation
        tokenizer=None,
        failure_threshold: float = 0.40,      # score < this = failure
        n_tasks_per_cycle: int = 200,
        n_seed_tasks: int = 200,
        save_dir: str = "outputs/benchmark",
        wandb_project: str = "scalable-llm-benchmark",
        llm_fn=None,                          # For agent task generation
    ):
        self.evaluator = evaluator
        self.base_llm = base_llm
        self.tokenizer = tokenizer
        self.failure_threshold = failure_threshold
        self.n_tasks_per_cycle = n_tasks_per_cycle
        self.save_dir = Path(save_dir)
        self.save_dir.mkdir(parents=True, exist_ok=True)

        # Initialize the four agents
        self.task_generator = TaskGeneratorAgent(llm_fn=llm_fn)
        self.failure_analyzer = FailureAnalyzerAgent()
        self.difficulty_controller = DifficultyController(initial_difficulty=0.3)
        self.task_refiner = TaskRefinerAgent(
            task_generator=self.task_generator,
            llm_fn=llm_fn,
            tasks_per_cluster=10,
        )

        # State
        self.task_pool: List[Task] = []
        self.all_failures: List[Task] = []
        self.cycle_metrics_history: List[CycleMetrics] = []
        self._cycle = 0

        # W&B
        wandb.init(
            project=wandb_project,
            name="benchmark-evolution",
            tags=["benchmark", "agentic", "failure-driven"],
        )

    # ──────────────────────────────────────────────────────────────────────
    # Core Evaluation
    # ──────────────────────────────────────────────────────────────────────

    def _generate_response(self, task_text: str) -> str:
        """
        Generate response from the base LLM for a given task.
        In production: use vLLM or TGI for fast batched inference.
        """
        if self.base_llm is None or self.tokenizer is None:
            # Simulation mode: return a placeholder response
            return f"[SIMULATED RESPONSE] Task: {task_text[:50]}..."

        self.base_llm.eval()
        device = next(self.base_llm.parameters()).device
        inputs = self.tokenizer(
            task_text, return_tensors="pt", max_length=512,
            truncation=True
        ).to(device)

        with torch.no_grad():
            outputs = self.base_llm.generate(
                **inputs,
                max_new_tokens=256,
                do_sample=True,
                temperature=0.7,
                pad_token_id=self.tokenizer.eos_token_id,
            )
        prompt_len = inputs["input_ids"].shape[1]
        return self.tokenizer.decode(outputs[0][prompt_len:], skip_special_tokens=True)

    @torch.no_grad()
    def _evaluate_response(
        self, task_text: str, response: str
    ) -> Tuple[float, float]:
        """
        Score a response with the Project 1 evaluator.
        Returns (score, confidence).
        """
        if self.evaluator is None or self.tokenizer is None:
            # Simulation mode
            score = float(np.random.beta(2, 2))   # beta distribution centered around 0.5
            confidence = float(np.random.uniform(0.4, 0.95))
            return score, confidence

        self.evaluator.eval()
        device = next(self.evaluator.parameters()).device
        text = f"Prompt: {task_text}\n\nResponse: {response}"
        enc = self.tokenizer(
            text, return_tensors="pt", max_length=2048, truncation=True
        ).to(device)

        score, confidence, _ = self.evaluator(enc["input_ids"], enc["attention_mask"])
        return score.item(), confidence.item()

    # ──────────────────────────────────────────────────────────────────────
    # Evolution Cycle
    # ──────────────────────────────────────────────────────────────────────

    def evolution_step(self) -> CycleMetrics:
        """
        Execute one full evolution cycle.

        Returns:
            CycleMetrics for this cycle (logged to W&B automatically)
        """
        self._cycle += 1
        logger.info(f"\n{'='*60}")
        logger.info(f"Evolution Cycle {self._cycle}")
        logger.info(f"  Difficulty: {self.difficulty_controller.current_difficulty:.2f}")
        logger.info(f"{'='*60}")

        # ── Phase 1: Generate Tasks ────────────────────────────────────
        if self._cycle == 1:
            logger.info("Phase 1: Generating seed tasks...")
            generated = self.task_generator.generate_seed_tasks(
                n_per_category=self.n_tasks_per_cycle // len(TASK_CATEGORIES)
            )
        else:
            logger.info("Phase 1: Generating failure-conditioned tasks...")
            generated = self.task_refiner.refine_from_clusters(
                failure_analyzer=self.failure_analyzer,
                difficulty=self.difficulty_controller.current_difficulty,
                top_k_clusters=5,
            )
            # Also add some fresh seed tasks for coverage
            fresh_n = max(20, self.n_tasks_per_cycle // 5)
            fresh = self.task_generator.generate_seed_tasks(
                n_per_category=fresh_n // len(TASK_CATEGORIES)
            )
            generated = generated + fresh

        logger.info(f"  Generated {len(generated)} tasks")

        # ── Phase 2: Evaluate Tasks ─────────────────────────────────────
        logger.info("Phase 2: Evaluating tasks...")
        cycle_tasks: List[Task] = []
        cycle_failures: List[Task] = []
        confidence_scores = []

        for gen_task in generated:
            # Generate response from LLM under evaluation
            response = self._generate_response(gen_task.text)

            # Score with Project 1 evaluator
            score, confidence = self._evaluate_response(gen_task.text, response)
            confidence_scores.append(confidence)

            failed = score < self.failure_threshold

            task = Task(
                generated=gen_task,
                response=response,
                evaluator_score=score,
                evaluator_confidence=confidence,
                failed=failed,
                cycle=self._cycle,
            )

            cycle_tasks.append(task)
            if failed:
                cycle_failures.append(task)

        failure_rate = len(cycle_failures) / max(len(cycle_tasks), 1)
        logger.info(
            f"  Evaluated {len(cycle_tasks)} tasks | "
            f"Failures: {len(cycle_failures)} ({failure_rate:.1%})"
        )

        # ── Phase 3: Analyze Failures ───────────────────────────────────
        logger.info("Phase 3: Analyzing failures...")
        for task in cycle_failures:
            failure_type = self.failure_analyzer.classify_failure(
                task.generated.text, task.response
            )
            task.failure_type = failure_type
            task.generated.failure_type = failure_type
            self.failure_analyzer.add_failure(
                task.generated, task.response, failure_type
            )

        # ── Phase 4: Update Difficulty ───────────────────────────────────
        new_difficulty = self.difficulty_controller.update(failure_rate)
        logger.info(f"  Updated difficulty: {new_difficulty:.2f}")

        # ── Phase 5: Update Pool & History ──────────────────────────────
        self.task_pool.extend(cycle_tasks)
        self.all_failures.extend(cycle_failures)

        top_clusters = self.failure_analyzer.get_top_clusters(3)
        top_failure_types = [name for name, _ in top_clusters]

        metrics = CycleMetrics(
            cycle=self._cycle,
            n_tasks_generated=len(cycle_tasks),
            n_failures=len(cycle_failures),
            failure_rate=failure_rate,
            difficulty=new_difficulty,
            unique_failure_clusters=self.failure_analyzer.get_unique_failure_count(),
            n_adversarial_tasks=sum(
                1 for t in cycle_tasks if t.generated.adversarial
            ),
            mean_evaluator_confidence=float(np.mean(confidence_scores)),
            top_failure_types=top_failure_types,
        )
        self.cycle_metrics_history.append(metrics)

        # ── Phase 6: Log Metrics ─────────────────────────────────────────
        wandb.log({
            "cycle": self._cycle,
            "benchmark/failure_rate": failure_rate,
            "benchmark/difficulty": new_difficulty,
            "benchmark/unique_failure_clusters": metrics.unique_failure_clusters,
            "benchmark/n_tasks_generated": metrics.n_tasks_generated,
            "benchmark/n_failures": metrics.n_failures,
            "benchmark/n_adversarial": metrics.n_adversarial_tasks,
            "benchmark/mean_confidence": metrics.mean_evaluator_confidence,
            "benchmark/pool_size": len(self.task_pool),
        })

        logger.info(
            f"Cycle {self._cycle} complete | "
            f"Pool: {len(self.task_pool)} | "
            f"Failure clusters: {metrics.unique_failure_clusters} | "
            f"Top failures: {top_failure_types}"
        )

        return metrics

    def run(self, n_cycles: int, save_every: int = 5) -> List[CycleMetrics]:
        """
        Run n_cycles of evolution.

        Args:
            n_cycles:    Total evolution cycles to run
            save_every:  Save task pool to disk every N cycles

        Returns:
            List of CycleMetrics, one per cycle
        """
        logger.info(f"Starting AgenticBenchmarkSystem: {n_cycles} cycles")
        start_time = time.time()

        for cycle_i in range(n_cycles):
            metrics = self.evolution_step()

            if (cycle_i + 1) % save_every == 0:
                self.save_task_pool()

        total_time = time.time() - start_time
        logger.info(
            f"\nEvolution complete in {total_time/60:.1f} min | "
            f"Total tasks: {len(self.task_pool)} | "
            f"Total failures: {len(self.all_failures)} | "
            f"Unique failure types: {self.failure_analyzer.get_unique_failure_count()}"
        )

        self.save_task_pool()
        wandb.finish()
        return self.cycle_metrics_history

    # ──────────────────────────────────────────────────────────────────────
    # Persistence
    # ──────────────────────────────────────────────────────────────────────

    def save_task_pool(self) -> None:
        """Save full task pool to JSONL file."""
        path = self.save_dir / f"task_pool_cycle_{self._cycle:04d}.jsonl"
        with open(path, "w") as f:
            for task in self.task_pool:
                record = task.generated.to_dict()
                record.update({
                    "evaluator_score": task.evaluator_score,
                    "evaluator_confidence": task.evaluator_confidence,
                    "failed": task.failed,
                    "failure_type": task.failure_type,
                    "cycle": task.cycle,
                })
                f.write(json.dumps(record) + "\n")
        logger.info(f"Task pool saved: {path} ({len(self.task_pool)} records)")

    def get_failure_report(self) -> dict:
        """Return structured failure analysis report."""
        return {
            "total_tasks": len(self.task_pool),
            "total_failures": len(self.all_failures),
            "overall_failure_rate": len(self.all_failures) / max(len(self.task_pool), 1),
            "unique_failure_clusters": self.failure_analyzer.get_unique_failure_count(),
            "failure_cluster_sizes": self.failure_analyzer._clusters,
            "cycles_run": self._cycle,
        }

    def get_hard_samples_for_rlhf(
        self, top_k: int = 500
    ) -> List[dict]:
        """
        Export the hardest failure cases for Project 2 RLHF training.

        Selects tasks where:
          - Model failed (score < threshold)
          - Evaluator confidence is high (confident the failure is real)
          - High failure_type diversity (not all the same type)

        Returns:
            List of dicts suitable for RLHF prompt pool
        """
        # Sort failures by (confidence, diversity) proxy
        high_conf_failures = sorted(
            self.all_failures,
            key=lambda t: t.evaluator_confidence,
            reverse=True,
        )[:top_k * 3]

        # Deduplicate by failure type to ensure diversity
        seen_types: Dict[str, int] = {}
        selected = []
        for task in high_conf_failures:
            ft = task.failure_type or "unknown"
            if seen_types.get(ft, 0) < top_k // 8:
                selected.append({
                    "prompt": task.generated.text,
                    "category": task.generated.category,
                    "failure_type": ft,
                    "evaluator_score": task.evaluator_score,
                    "difficulty": task.generated.difficulty,
                })
                seen_types[ft] = seen_types.get(ft, 0) + 1

        logger.info(f"Exporting {len(selected)} hard samples to RLHF pipeline")
        return selected[:top_k]
